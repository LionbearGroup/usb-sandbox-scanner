# =============================================================================
# /etc/systemd/system/usb-sandbox@.service
# Serviço template — instanciado pelo udev com o nome do dispositivo
# Ex: systemctl start usb-sandbox@sdb1.service
# =============================================================================

[Unit]
Description=USB Sandbox Malware Scanner (%i)
After=network.target clamav-freshclam.service
Wants=clamav-freshclam.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/usb-sandbox-scan.sh %i

# --- Hardening de Segurança (systemd) ---
# Protege o host mesmo que o script seja comprometido

# Namespaces: isola mount, PID, IPC, UTS, user
PrivateTmp=yes
PrivateDevices=no          # precisa acessar /dev/<device>
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/usb-sandbox /var/log/usb-sandbox /tmp

# Capabilities: apenas as necessárias para montar
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
NoNewPrivileges=no

# Restrições de syscalls (seccomp)
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM

# Recursos
TimeoutStartSec=300        # 5 min máx para varredura
MemoryMax=512M
CPUQuota=80%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=usb-sandbox

[Install]
WantedBy=multi-user.target
